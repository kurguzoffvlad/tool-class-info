{
  "name": "tool-class-info",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "TESTING": "npx tsx src/test.ts",
    "TESTING:watch": "npx tsx watch src/test.ts",
    "ver:patch": "npm version patch --no-git-tag-version",
    "ver:minor": "npm version minor --no-git-tag-version",
    "ver:major": "npm version major --no-git-tag-version",
    "release:patch": "npm run ver:patch && npm run build && npm publish --access public",
    "release:minor": "npm run ver:minor && npm run build && npm publish --access public",
    "release:major": "npm run ver:major && npm run build && npm publish --access public"
  },
  "author": "Vladimir Kurguzov <kurguzov74@gmail.com>",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}
